# Application Configuration
APP_URL=http://localhost:3000
VITE_API_BASE_URL=http://localhost:8080

# Optional API Authentication Keys
VITE_API_KEY=your_api_key_here
VITE_AUTH_TOKEN=your_jwt_or_bearer_token_here

# Environment Vault Credentials
VITE_PROD_API_URL=https://api.prod.example.com
VITE_PROD_USERNAME=admin
VITE_PROD_SECRET_KEY=your_prod_secret_key_here

VITE_STAGE_API_URL=https://api.staging.example.com
VITE_STAGE_USERNAME=test_admin
VITE_STAGE_SECRET_KEY=your_staging_secret_key_here
